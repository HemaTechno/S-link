local function playCinematicTransition(oldWindow, callback)
    local transitionGui = Instance.new("ScreenGui")
    transitionGui.Name = "SubXCinematic"
    transitionGui.DisplayOrder = 999999
    transitionGui.IgnoreGuiInset = true
    
    local target = CoreGui
    if not pcall(function() transitionGui.Parent = target end) then
        transitionGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    end
    
    local fadeFrame = Instance.new("Frame", transitionGui)
    fadeFrame.Size = UDim2.new(1, 0, 1, 0)
    fadeFrame.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
    fadeFrame.BackgroundTransparency = 1
    fadeFrame.BorderSizePixel = 0
    
    local subxText = Instance.new("TextLabel", fadeFrame)
    subxText.Size = UDim2.new(1, 0, 1, 0)
    subxText.BackgroundTransparency = 1
    subxText.Text = "SubX Premium"
    subxText.TextColor3 = Color3.fromRGB(255, 215, 0) -- Gold
    subxText.Font = Enum.Font.GothamBold
    subxText.TextSize = 45
    subxText.TextTransparency = 1
    
    local textGlow = Instance.new("UIStroke", subxText)
    textGlow.Color = Color3.fromRGB(255, 215, 0) -- Gold
    textGlow.Transparency = 1
    textGlow.Thickness = 2
    
    TweenService:Create(fadeFrame, TweenInfo.new(0.6, Enum.EasingStyle.Sine), {BackgroundTransparency = 0}):Play()
    local textTween = TweenService:Create(subxText, TweenInfo.new(0.8, Enum.EasingStyle.Sine), {TextTransparency = 0, TextSize = 55})
    TweenService:Create(textGlow, TweenInfo.new(0.8, Enum.EasingStyle.Sine), {Transparency = 0.6}):Play()
    textTween:Play()
    
    textTween.Completed:Wait()
    task.wait(0.5)
    
    if oldWindow and oldWindow.Destroy then
        pcall(function() oldWindow:Destroy() end)
    end
    
    callback()
    task.wait(0.8) 
    
    TweenService:Create(subxText, TweenInfo.new(0.5, Enum.EasingStyle.Sine), {TextTransparency = 1, TextSize = 65}):Play()
    TweenService:Create(textGlow, TweenInfo.new(0.5, Enum.EasingStyle.Sine), {Transparency = 1}):Play()
    local fadeOut = TweenService:Create(fadeFrame, TweenInfo.new(0.6, Enum.EasingStyle.Sine), {BackgroundTransparency = 1})
    fadeOut:Play()
    fadeOut.Completed:Wait()
    
    transitionGui:Destroy()
end

local function destroyOldUI()
    local target1 = CoreGui
    local target2 = Players.LocalPlayer:FindFirstChild("PlayerGui")
    local function sweep(parent)
        if not parent then return end
        for _, v in pairs(parent:GetChildren()) do 
            if v:IsA("ScreenGui") and (v.Name == "WindUI" or v.Name == "SubXKey" or v.Name == "SubXConfig") then 
                pcall(function() v:Destroy() end)
            end 
        end
    end
    sweep(target1)
    sweep(target2)
end

