-- 7. الدخول التلقائي الذكي
-- ==========================================
local savedKey = ""
pcall(function() if isfile and isfile(KEY_FILE_NAME) then savedKey = readfile(KEY_FILE_NAME) end end)

if savedKey ~= "" then
    local verifyResult = checkKeyWithServer(savedKey)
    if verifyResult.success then
        loadScriptHub()
    else
        pcall(function() delfile(KEY_FILE_NAME) end)
        loadKeySystem()
    end
else
    loadKeySystem()
end
