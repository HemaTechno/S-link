local function checkKeyWithServer(keyToVerify)
    if requestFunc then
        local success, response = pcall(function()
            return requestFunc({
                Url = VERIFY_API_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({ key = keyToVerify, hwid = playerHWID })
            })
        end)
        if success and response and response.Body then
            local decSuccess, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
            if decSuccess then return decoded end
        end
    end
    return {success = false, message = "Connection error!"}
end

local function executeScriptSafe(scriptName, scriptUrl, Wind)
    Wind:Notify({Title = "Executing", Content = "Injecting " .. scriptName .. "...", Duration = 3})
    task.spawn(function()
        local s, err = pcall(function()
            local scriptContent = requestFunc and requestFunc({Url = scriptUrl, Method = "GET"}).Body or game:HttpGet(scriptUrl)
            loadstring(scriptContent)()
        end)
        if not s then
            Wind:Notify({Title = "Injection Failed", Content = tostring(err), Duration = 5})
        end
    end)
end

local function loadScriptHub()
    local WindUI = loadstring(WindUI_SRC)()
    applySubXTheme(WindUI)

    local Window = WindUI:CreateWindow({
        Title = "SubX Premium Hub",
        Icon = "crown", 
        Author = "by SubX",
        Folder = "SubXConfig",
        Size = UDim2.new(0, 580, 0, 380),
        Transparent = true,
        Theme = "SubXTheme", 
        SideBarWidth = 170
    })

    -- ==================== TAGS SYSTEM ====================
    Window:Tag({
        Title = "v1.0.0 Premium",
        Color = Color3.fromRGB(60, 60, 65)
    })
    
    local FPSTag = Window:Tag({
        Title = "FPS: 0",
        Color = Color3.fromRGB(100, 150, 255),
    })

    local lastUpdate = tick()
    local frameCount = 0

    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        
        if now - lastUpdate >= 1 then
            local fps = math.floor(frameCount / (now - lastUpdate))
            FPSTag:SetTitle("FPS: " .. fps)
            
            if fps >= 50 then
                FPSTag:SetColor(Color3.fromRGB(74, 222, 128)) 
            elseif fps >= 30 then
                FPSTag:SetColor(Color3.fromRGB(250, 204, 21)) 
            else
                FPSTag:SetColor(Color3.fromRGB(248, 113, 113)) 
            end
            
            frameCount = 0
            lastUpdate = now
        end
    end)
    -- ====================================================================

    WindUI:Notify({
        Title = "Welcome to SubX Premium",
        Content = "Hello, " .. Players.LocalPlayer.DisplayName .. " 👑",
        Duration = 5
    })

    -- ==================== TAB: MAIN ====================
    local HomeTab = Window:Tab({ Title = "Main", Icon = "layout-dashboard" })
    HomeTab:Select()
    
    local LocalPlayer = Players.LocalPlayer
    
    HomeTab:Section({ Title = "My Profile", Icon = "user" })
    HomeTab:Paragraph({
        Title = LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")",
        Desc = "User ID: " .. tostring(LocalPlayer.UserId) .. "\nAccount Age: " .. tostring(LocalPlayer.AccountAge) .. " Days",
        Icon = "circle-user"
    })
    
    HomeTab:Section({ Title = "Community", Icon = "globe" })
    
    HomeTab:Button({
        Title = "Join Discord Server",
        Desc = "Click to copy our Discord invite link",
        Icon = "message-square",
        Callback = function()
            if setclipboard then
                setclipboard(DISCORD_INVITE)
                WindUI:Notify({Title = "Success!", Content = "Discord link copied to clipboard.", Duration = 3})
            end
        end
    })
    
    HomeTab:Button({
        Title = "Subscribe to YouTube",
        Desc = "Click to copy our YouTube channel link",
        Icon = "youtube",
        Callback = function()
            if setclipboard then
                setclipboard(YOUTUBE_LINK)
                WindUI:Notify({Title = "Success!", Content = "YouTube link copied to clipboard.", Duration = 3})
            end
        end
    })

    -- جلب المابات وإعدادات الهاك
    task.spawn(function()
        local success, response = pcall(function() return requestFunc({Url = GET_SCRIPTS_URL, Method = "GET"}) end)
        if success and response and response.Body then
            local decSuccess, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
            if decSuccess and data.success and data.games then
                for _, gameData in pairs(data.games) do
                    local GameTab = Window:Tab({ Title = gameData.gameName, Icon = "gamepad-2" })
                    GameTab:Section({ Title = "Available Scripts", Icon = "list" })
                    
                    for _, scriptData in pairs(gameData.scripts) do
                        GameTab:Button({
                            Title = scriptData.name,
                            Desc = "Click to execute this script safely",
                            Icon = "rocket",
                            Callback = function()
                                local dialogSuccess = pcall(function()
                                    Window:Dialog({
                                        Title = "Execute Script?",
                                        Content = "Are you sure you want to execute [" .. scriptData.name .. "]?",
                                        Icon = "shield-alert",
                                        Buttons = {
                                            {
                                                Title = "<font color='#4ade80'>Execute 🟢</font>", 
                                                Callback = function() executeScriptSafe(scriptData.name, scriptData.url, WindUI) end
                                            },
                                            {
                                                Title = "<font color='#f87171'>Cancel 🔴</font>", 
                                                Callback = function() WindUI:Notify({Title = "Cancelled", Content = "Action aborted.", Duration = 2}) end
                                            }
                                        }
                                    })
                                end)
                                
                                if not dialogSuccess then
                                    executeScriptSafe(scriptData.name, scriptData.url, WindUI)
                                end
                            end
                        })
                    end
                end
            end
        else
            HomeTab:Section({ Title = "Error Loading Scripts", Icon = "triangle-alert" })
        end

        -- ==================== TAB: INFO / SETTINGS ====================
        local SettingsTab = Window:Tab({ Title = "Info & Settings", Icon = "settings" })
        
        SettingsTab:Section({ Title = "Hub Management", Icon = "sliders-horizontal" })
        SettingsTab:Button({
            Title = "Copy HWID",
            Desc = "Copy your unique hardware ID for support",
            Icon = "copy",
            Callback = function()
                if setclipboard then
                    setclipboard(playerHWID)
                    WindUI:Notify({Title = "Copied!", Content = "HWID copied to clipboard.", Duration = 3})
                end
            end
        })
        
        SettingsTab:Button({
            Title = "<font color='#f87171'>Unload UI</font>",
            Desc = "Completely remove the script UI",
            Icon = "trash-2",
            Callback = function()
                destroyOldUI()
            end
        })

        SettingsTab:Section({ Title = "Server Management", Icon = "server" })
        SettingsTab:Button({
            Title = "<font color='#fbbf24'>Rejoin Place</font>",
            Desc = "Reconnect to this exact server",
            Icon = "refresh-ccw",
            Callback = function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end
        })
        
        SettingsTab:Button({
            Title = "Server Hop",
            Desc = "Find and join a different server",
            Icon = "globe",
            Callback = function()
                WindUI:Notify({Title = "Searching...", Content = "Finding a new server...", Duration = 3})
                task.spawn(function()
                    local sfUrl = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
                    local req = requestFunc({Url = sfUrl})
                    if req and req.Body then
                        local body = HttpService:JSONDecode(req.Body)
                        if body and body.data then
                            for _, v in ipairs(body.data) do
                                if type(v) == "table" and v.playing < v.maxPlayers and v.id ~= game.JobId then
                                    TeleportService:TeleportToPlaceInstance(game.PlaceId, v.id, LocalPlayer)
                                    return
                                end
                            end
                        end
                    end
                end)
            end
        })
    end)
end

local function loadKeySystem()
    local WindUI = loadstring(WindUI_SRC)()
    applySubXTheme(WindUI)

    local Window = WindUI:CreateWindow({
        Title = "SubX Key System",
        Icon = "key",
        Author = "by SubX",
        Folder = "SubXKey",
        Size = UDim2.new(0, 420, 0, 280),
        Transparent = true,
        Theme = "SubXTheme"
    })
    
    Window:Tag({
        Title = "v1.0.0 Premium",
        Color = Color3.fromRGB(60, 60, 65)
    })

    local AuthTab = Window:Tab({ Title = "Authentication", Icon = "shield-check" })
    AuthTab:Select()
    AuthTab:Section({ Title = "License Verification", Icon = "lock" })

    local keyInput = ""
    AuthTab:Input({
        Title = "Enter Key",
        Desc = "Paste your SUBX-XXXX key here",
        PlaceholderText = "Paste key...",
        Icon = "key",
        ClearTextOnFocus = false,
        Callback = function(text) keyInput = text end
    })

    AuthTab:Button({
        Title = "Verify Key",
        Icon = "circle-check",
        Callback = function()
            if keyInput == "" then
                WindUI:Notify({Title = "Error", Content = "Please enter a key first!", Duration = 2})
                return
            end
            
            WindUI:Notify({Title = "Checking", Content = "Verifying key with server...", Duration = 2})
            task.spawn(function()
                local result = checkKeyWithServer(keyInput)
                if result.success then
                    pcall(function() writefile(KEY_FILE_NAME, keyInput) end)
                    
                    playCinematicTransition(Window, function()
                        loadScriptHub()
                    end)
                else
                    WindUI:Notify({Title = "Failed", Content = result.message or "Invalid Key", Duration = 3})
                end
            end)
        end
    })

    AuthTab:Section({ Title = "Need a Key?", Icon = "circle-help" })
    AuthTab:Button({
        Title = "Get Key Link",
        Desc = "Click to copy the key generation link",
        Icon = "link",
        Callback = function()
            if setclipboard then
                setclipboard(GET_KEY_LINK)
                WindUI:Notify({Title = "Copied!", Content = "Link copied! Paste it in your browser.", Duration = 3})
            end
        end
    })
end

